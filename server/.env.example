# InternAtlas Server — Environment Variable Template
# Copy this file to .env and fill in the values. Never commit .env.
# See docs/DEPLOYMENT.md for full setup instructions.

# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
# MongoDB Atlas URI (production) or local URI (development)
MONGO_URI=mongodb://localhost:27017/internatlas

# ============================================
# JWT SECRETS (minimum 32 characters in production)
# ============================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# FRONTEND URL (used for links in emails etc.)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# EMAIL PROVIDER
# ============================================
# EMAIL_PROVIDER=mock    → logs to console (default / development)
# EMAIL_PROVIDER=smtp    → sends real emails via SMTP
EMAIL_PROVIDER=mock

# SMTP configuration (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@internatlas.com

# ============================================
# FILE STORAGE
# ============================================
# STORAGE_PROVIDER=local → stores files on local disk (default)
# STORAGE_PROVIDER=s3    → stores files on AWS S3
STORAGE_PROVIDER=local

# AWS S3 configuration (required if STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
